rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function activeUser() {
      return profileExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }
    function isAdmin() {
      return activeUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isLeader(clubId) {
      return activeUser() && exists(/databases/$(database)/documents/clubs/$(clubId)) && (
        request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('leaderIds', []) ||
        get(/databases/$(database)/documents/clubs/$(clubId)).data.get('createdBy', '') == request.auth.uid
      );
    }
    function canManageClub(clubId) { return isAdmin() || isLeader(clubId); }

    match /users/{uid} {
      // Public signup can only create a student account. Admins grant elevated roles.
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'student' &&
        request.resource.data.get('suspended', false) == false;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() ||
        (activeUser() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('suspended', false) == resource.data.get('suspended', false) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if resource.data.status == 'approved' ||
        (activeUser() && (isAdmin() ||
          resource.data.get('createdBy', '') == request.auth.uid ||
          request.auth.uid in resource.data.get('leaderIds', [])));
      allow create: if activeUser() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.leaderIds &&
        (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
            request.resource.data.status in ['approved', 'pending']) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'leader' &&
            request.resource.data.status == 'pending')
        );
      allow update: if isAdmin() ||
        (isLeader(clubId) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.leaderIds == resource.data.leaderIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'description', 'meetingInfo', 'glyph', 'updatedAt']));
      allow delete: if isAdmin();

      match /announcements/{announcementId} {
        allow read: if get(/databases/$(database)/documents/clubs/$(clubId)).data.status == 'approved' || canManageClub(clubId);
        allow create: if canManageClub(clubId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if canManageClub(clubId);
      }
      match /events/{eventId} {
        allow read: if get(/databases/$(database)/documents/clubs/$(clubId)).data.status == 'approved' || canManageClub(clubId);
        allow create: if canManageClub(clubId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if canManageClub(clubId);
      }
    }

    match /memberships/{membershipId} {
      allow create: if activeUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.clubId is string &&
        exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)) &&
        get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.status == 'approved';
      allow read: if activeUser() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isLeader(resource.data.clubId));
      allow delete: if activeUser() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isLeader(resource.data.clubId));
      allow update: if false;
    }
  }
}
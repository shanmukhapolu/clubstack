rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/disabledUsers/$(request.auth.uid)); }
    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student')
        : '';
    }
    function isAdmin() { return userRole() == 'admin'; }
    function isTeacher() { return userRole() == 'teacher'; }
    function privateClubExists(clubId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId));
    }
    function privateClub(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }
    function isMember(clubId) {
      return signedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + clubId));
    }
    function isLeader(clubId) {
      return signedIn() && privateClub(clubId).leaderId == request.auth.uid;
    }
    function isOfficer(clubId) {
      return signedIn() && privateClub(clubId).get('officerIds', []).hasAny([request.auth.uid]);
    }
    function isSponsor(clubId) {
      return signedIn() && privateClub(clubId).sponsorId == request.auth.uid
        && privateClub(clubId).sponsorStatus == 'accepted';
    }
    function isSponsorCandidate(clubId) {
      return signedIn() && privateClubExists(clubId)
        && privateClub(clubId).sponsorId == request.auth.uid;
    }
    function isPendingOfficerInvite(clubId) {
      return signedIn()
        && exists(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.status == 'pending'
        && get(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.invitedUserId == request.auth.uid;
    }
    function isManager(clubId) {
      return isAdmin() || isLeader(clubId) || isOfficer(clubId) || isSponsor(clubId);
    }
    function pendingTransferFrom(data) {
      return data.get('pendingLeaderTransfer', null) is map
        ? data.pendingLeaderTransfer.get('fromId', '')
        : '';
    }
    function pendingTransferTo(data) {
      return data.get('pendingLeaderTransfer', null) is map
        ? data.pendingLeaderTransfer.get('toId', '')
        : '';
    }
    function deletionApproved(clubId) {
      return exists(/databases/$(database)/documents/clubDeletionRequests/$(clubId))
        && get(/databases/$(database)/documents/clubDeletionRequests/$(clubId)).data.status == 'approved';
    }
    function canReadPrivateClub(clubId) {
      return isAdmin() || isMember(clubId) || isLeader(clubId) || isOfficer(clubId) || isSponsorCandidate(clubId);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function directoryFieldsValid(data) {
      return data.keys().hasOnly([
          'name', 'description', 'category', 'emoji', 'color', 'status',
          'leaderName', 'sponsorName', 'meetingDay', 'meetingFrequency', 'meetingOrdinal',
          'customMeetingSchedule', 'meetingTime', 'location', 'contactEmail',
          'prerequisites', 'dues', 'instagramHandle', 'requiresApproval', 'membersVisible', 'hidden', 'createdAt'
        ])
        && data.name is string && data.name.size() >= 3
        && data.description is string && data.description.size() >= 20
        && data.category is string && data.emoji is string && data.color is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.leaderName is string && data.sponsorName is string
        && data.meetingDay is string
        && data.meetingFrequency in ['weekly', 'everyOtherWeek', 'monthly', 'custom']
        && data.meetingOrdinal in ['first', 'second', 'third', 'fourth', 'last']
        && data.customMeetingSchedule is string && data.meetingTime is string
        && data.location is string && data.contactEmail is string
        && data.prerequisites is string && data.dues is string && data.instagramHandle is string
        && data.requiresApproval is bool && data.membersVisible is bool
        && (!('hidden' in data.keys()) || data.hidden is bool)
        && data.createdAt is number;
    }
    function directoryMirrorMatchesPrivate(clubId) {
      return getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.description == request.resource.data.description
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.category == request.resource.data.category
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.emoji == request.resource.data.emoji
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.color == request.resource.data.color
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.status == request.resource.data.status
        && (!('hidden' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.hidden == request.resource.data.hidden)
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('leaderName', '') == request.resource.data.leaderName
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('sponsorName', '') == request.resource.data.sponsorName
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('meetingDay', 'Flexible') == request.resource.data.meetingDay
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('meetingTime', '') == request.resource.data.meetingTime
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('location', '') == request.resource.data.location
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.get('contactEmail', '') == request.resource.data.contactEmail
        && (!('meetingFrequency' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.meetingFrequency == request.resource.data.meetingFrequency)
        && (!('meetingOrdinal' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.meetingOrdinal == request.resource.data.meetingOrdinal)
        && (!('customMeetingSchedule' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.customMeetingSchedule == request.resource.data.customMeetingSchedule)
        && (!('prerequisites' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.prerequisites == request.resource.data.prerequisites)
        && (!('dues' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.dues == request.resource.data.dues)
        && (!('instagramHandle' in getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.keys()) || getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.instagramHandle == request.resource.data.instagramHandle);
    }

    // Tombstones block deleted accounts from recreating their profile on the next sign-in.
    match /disabledUsers/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.disabledBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // New accounts always start as students. Privileged roles must be assigned by an existing administrator.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt', 'grade'])
        && request.resource.data.role == 'student'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.email is string;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && onlyChanged(['displayName', 'grade'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2);
      allow delete: if isAdmin();
    }

    match /userDirectory/{userId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'createdAt', 'nameLower'])
        && request.resource.data.displayName is string
        && request.resource.data.role in ['student', 'teacher', 'admin']
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(userId)).data.role
        && request.resource.data.nameLower is string);
      allow delete: if isAdmin();
    }

    // Directory summaries expose stable club basics only; event dates, announcements, officer lists, and sponsor identifiers remain private.
    match /clubDirectory/{clubId} {
      allow read: if signedIn() && (
        resource.data.status == 'approved' || isAdmin() || isManager(clubId) || isMember(clubId) || isSponsorCandidate(clubId) || isPendingOfficerInvite(clubId)
      );
      allow create: if signedIn()
        && directoryFieldsValid(request.resource.data)
        && privateClubExists(clubId)
        && (isAdmin() || isManager(clubId))
        && directoryMirrorMatchesPrivate(clubId);
      allow update: if (isAdmin() && directoryFieldsValid(request.resource.data))
        || (onlyChanged(['name','description','category','emoji','color','status','sponsorName','meetingDay','meetingFrequency','meetingOrdinal','customMeetingSchedule','meetingTime','location','contactEmail','prerequisites','dues','instagramHandle','requiresApproval','membersVisible','hidden','createdAt'])
          && directoryFieldsValid(request.resource.data)
          && isManager(clubId)
          && directoryMirrorMatchesPrivate(clubId))
        || (onlyChanged(['leaderName'])
          && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.leaderId is string
          && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.leaderId != get(/databases/$(database)/documents/clubs/$(clubId)).data.leaderId
          && request.resource.data.leaderName == getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.leaderName)
        || (isTeacher() && isSponsorCandidate(clubId)
          && privateClub(clubId).sponsorStatus == 'pending'
          && onlyChanged(['sponsorName'])
          && request.resource.data.sponsorName is string
          && directoryMirrorMatchesPrivate(clubId))
        || (isTeacher()
          && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.teacherId == request.auth.uid
          && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.stage == 'newSponsorApproval'
          && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.status == 'accepted'
          && onlyChanged(['sponsorName'])
          && request.resource.data.sponsorName == getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.sponsorName
          && directoryMirrorMatchesPrivate(clubId));

      allow delete: if isAdmin() || (isLeader(clubId) && deletionApproved(clubId));
    }

    match /clubs/{clubId} {
      allow read: if signedIn() && (
        isAdmin() || isMember(clubId) || resource.data.leaderId == request.auth.uid
        || resource.data.get('officerIds', []).hasAny([request.auth.uid])
        // A teacher who was invited to sponsor this club must be able to read the
        // pending club document so the accept/decline transaction can complete.
        || (resource.data.sponsorId == request.auth.uid && resource.data.sponsorStatus == 'accepted')
        || (resource.data.get('previousSponsorId', '') == request.auth.uid && resource.data.status == 'pending')
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name','description','category','meetingDay','meetingFrequency','meetingOrdinal','customMeetingSchedule',
           'meetingTime','location','emoji','color','prerequisites','dues','instagramHandle',
          'contactEmail','leaderTitle','officers','officerIds','sponsorId','sponsorName',
          'status','leaderId','leaderName','sponsorStatus','createdAt'
        ])
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.officers is list && request.resource.data.officers.size() == 1
        && request.resource.data.officers[0].uid == request.auth.uid
        && request.resource.data.officers[0].displayName == request.resource.data.leaderName
        && request.resource.data.officers[0].title == request.resource.data.leaderTitle
        && request.resource.data.officerIds is list && request.resource.data.officerIds.size() == 1
        && request.resource.data.officerIds[0] == request.auth.uid
        && ((request.resource.data.sponsorId == '' && request.resource.data.sponsorStatus == 'none')
          || (request.resource.data.sponsorId is string && request.resource.data.sponsorId.size() > 0 && request.resource.data.sponsorStatus == 'pending'))
        && request.resource.data.name is string && request.resource.data.name.size() >= 3
        && request.resource.data.description is string && request.resource.data.description.size() >= 20
        && request.resource.data.category is string
        && request.resource.data.emoji is string && request.resource.data.color is string
        && request.resource.data.contactEmail is string
        && request.resource.data.createdAt is number
        && request.resource.data.leaderTitle is string
        && request.resource.data.officers is list
        && request.resource.data.officerIds is list
        && request.resource.data.sponsorId is string
        && request.resource.data.sponsorName is string
        && request.resource.data.sponsorStatus in ['pending', 'none'];
      allow update: if (isTeacher()
          && resource.data.sponsorId == request.auth.uid
          && resource.data.sponsorStatus == 'accepted'
          && onlyChanged(['leaderId','leaderName','leaderTitle','officers','officerIds','pendingLeaderTransfer'])
          && request.resource.data.leaderId is string
          && request.resource.data.leaderId != resource.data.leaderId
          && get(/databases/$(database)/documents/users/$(request.resource.data.leaderId)).data.role == 'student'
          && request.resource.data.officerIds is list
          && request.resource.data.officerIds.hasAny([request.resource.data.leaderId])
          && request.resource.data.officers is list
          && request.resource.data.pendingLeaderTransfer == null)
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount']))
        || (
          onlyChanged(['name','description','category','meetingDay','meetingFrequency','meetingOrdinal','customMeetingSchedule','meetingTime','location','emoji','color','contactEmail','prerequisites','dues','instagramHandle','leaderTitle'])
          && (resource.data.leaderId == request.auth.uid || isSponsor(clubId) || isOfficer(clubId))
        )
        || (
          onlyChanged(['officers','officerIds','leaderTitle'])
          && (resource.data.leaderId == request.auth.uid || isSponsor(clubId))
          && request.resource.data.officerIds is list
          && request.resource.data.officers is list
          && request.resource.data.officerIds.hasAny([resource.data.leaderId])
        )
        || (
          signedIn()
          && userRole() == 'student'
          && onlyChanged(['officers','officerIds'])
          && !resource.data.get('officerIds', []).hasAny([request.auth.uid])
          && request.resource.data.officerIds is list
          && request.resource.data.officerIds.hasAny([request.auth.uid])
          && request.resource.data.officerIds.hasAll(resource.data.get('officerIds', []))
          && getAfter(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.invitedUserId == request.auth.uid
        )
        || (
          onlyChanged(['pendingLeaderTransfer'])
          && (
            (
              resource.data.leaderId == request.auth.uid
              && resource.data.get('pendingLeaderTransfer', null) == null
              && pendingTransferFrom(request.resource.data) == request.auth.uid
              && pendingTransferTo(request.resource.data) is string
              && request.pendingTransferTo(resource.data) != request.auth.uid
              && resource.data.get('officerIds', []).hasAny([request.resource.data.pendingLeaderTransfer.toId])
            )
            || (
              resource.data.get('pendingLeaderTransfer', null) != null && resource.data.pendingLeaderTransfer.toId == request.auth.uid
              && request.resource.data.pendingLeaderTransfer == null
            )

          )
        )
        || (
          onlyChanged(['leaderId','leaderName','leaderTitle','officers','officerIds','pendingLeaderTransfer'])
          && resource.data.get('pendingLeaderTransfer', null) != null && resource.data.pendingLeaderTransfer.toId == request.auth.uid
          && resource.data.leaderId == pendingTransferFrom(resource.data)
          && resource.data.get('officerIds', []).hasAny([request.auth.uid])
          && request.resource.data.leaderId == request.auth.uid
          && request.resource.data.leaderTitle is string
          && request.resource.data.officerIds.hasAny([request.auth.uid])
          && request.resource.data.officerIds.hasAny([resource.data.leaderId])
          && request.resource.data.pendingLeaderTransfer == null
        )
        || (
          onlyChanged(['sponsorId','sponsorName','sponsorStatus'])
          && (
            (
              resource.data.leaderId == request.auth.uid
              && request.resource.data.sponsorId is string
              && request.resource.data.sponsorName is string
              && request.resource.data.sponsorStatus == 'pending'
              && get(/databases/$(database)/documents/users/$(request.resource.data.sponsorId)).data.role == 'teacher'
            )
            || (
              isTeacher()
              && resource.data.sponsorId == request.auth.uid
              && resource.data.sponsorStatus == 'pending'
              && request.resource.data.sponsorStatus in ['accepted','declined']
            )
            || (
              isTeacher()
              && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.teacherId == request.auth.uid
              && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.stage == 'newSponsorApproval'
              && getAfter(/databases/$(database)/documents/clubSponsorRequests/$(clubId + '_sponsor_change')).data.status == 'accepted'
              && request.resource.data.sponsorId == request.auth.uid
              && request.resource.data.sponsorStatus == 'accepted'
            )
          )
        );
      allow delete: if isAdmin() || (isLeader(clubId) && deletionApproved(clubId));
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        membershipId.matches('^' + request.auth.uid + '_.+')
        || resource.data.uid == request.auth.uid || isAdmin() || isManager(resource.data.clubId)
        || (isMember(resource.data.clubId)
          && get(/databases/$(database)/documents/clubDirectory/$(resource.data.clubId)).data.membersVisible == true)
      );
      allow create: if signedIn()
        && membershipId == request.resource.data.uid + '_' + request.resource.data.clubId
        && request.resource.data.uid is string
        && request.resource.data.clubId is string
        && request.resource.data.joinedAt is number
        && (
          (request.resource.data.uid == request.auth.uid && userRole() == 'student'
            && get(/databases/$(database)/documents/clubDirectory/$(request.resource.data.clubId)).data.status == 'approved'
            && get(/databases/$(database)/documents/clubDirectory/$(request.resource.data.clubId)).data.requiresApproval == false)
          || (request.resource.data.uid == request.auth.uid && isLeader(request.resource.data.clubId)
            && privateClub(request.resource.data.clubId).status == 'pending')
          || (request.resource.data.uid == request.auth.uid && userRole() == 'student'
            && getAfter(/databases/$(database)/documents/officerInvitations/$(request.resource.data.clubId + '_' + request.auth.uid)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/officerInvitations/$(request.resource.data.clubId + '_' + request.auth.uid)).data.invitedUserId == request.auth.uid)
          || (isManager(request.resource.data.clubId)
            && get(/databases/$(database)/documents/clubDirectory/$(request.resource.data.clubId)).data.status == 'approved'
            && getAfter(/databases/$(database)/documents/clubJoinRequests/$(request.resource.data.clubId + '_' + request.resource.data.uid)).data.status == 'approved'
            && get(/databases/$(database)/documents/clubJoinRequests/$(request.resource.data.clubId + '_' + request.resource.data.uid)).data.status == 'pending'
            && get(/databases/$(database)/documents/clubJoinRequests/$(request.resource.data.clubId + '_' + request.resource.data.uid)).data.uid == request.resource.data.uid)
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || isManager(resource.data.clubId)
        || (isLeader(resource.data.clubId) && deletionApproved(resource.data.clubId));
      allow update: if false;
    }

    match /clubJoinRequests/{requestId} {
      allow create: if signedIn()
        && requestId == request.resource.data.clubId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && userRole() == 'student'
        && request.resource.data.clubId is string
        && get(/databases/$(database)/documents/clubDirectory/$(request.resource.data.clubId)).data.status == 'approved'
        && get(/databases/$(database)/documents/clubDirectory/$(request.resource.data.clubId)).data.requiresApproval == true
        && !exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + request.resource.data.clubId))
        && request.resource.data.clubName is string
        && request.resource.data.displayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(['clubId','clubName','uid','displayName','status','createdAt']);
      // Allow a student to check their own deterministic request path even before that document exists.
      allow read: if isAdmin() || (signedIn() && (
        requestId.matches('.*_' + request.auth.uid)
        || resource.data.uid == request.auth.uid || isManager(resource.data.clubId)
      ));
      allow update: if (signedIn() && isManager(resource.data.clubId)
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved','declined'])
        || (signedIn() && userRole() == 'student'
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','createdAt'])
          && request.resource.data.createdAt is number);
      allow delete: if isAdmin() || isManager(resource.data.clubId);
    }

    match /clubDeletionRequests/{clubId} {
      allow read: if isAdmin() || isManager(clubId);
      allow create: if signedIn()
        && isLeader(clubId)
        && privateClub(clubId).sponsorStatus == 'accepted'
        && privateClub(clubId).sponsorId is string
        && request.resource.data.clubId == clubId
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.requestedByName is string
        && request.resource.data.clubName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(['clubId','clubName','requestedById','requestedByName','status','createdAt']);
      allow update: if (signedIn() && isLeader(clubId)
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.requestedById == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubName','requestedByName','status','createdAt']))
        || (signedIn() && isTeacher() && isSponsor(clubId)
          && resource.data.status == 'pending'
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.requestedById == resource.data.requestedById
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedById'])
          && request.resource.data.status in ['approved','declined']
          && request.resource.data.reviewedAt is number
          && request.resource.data.reviewedById == request.auth.uid);
      allow delete: if isAdmin() || (isLeader(clubId) && resource.data.status == 'approved');
    }

    match /clubSponsorRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.teacherId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role == 'teacher'
        && request.resource.data.clubId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && (
          (request.resource.data.stage == 'currentSponsorApproval'
            && userRole() == 'student'
            && (isMember(request.resource.data.clubId)
              || get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leaderId == request.auth.uid)
            && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.sponsorId == request.resource.data.previousSponsorId
            && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.sponsorStatus == 'accepted'
            && request.resource.data.previousSponsorId != request.resource.data.teacherId)
          || (!('stage' in request.resource.data.keys())
            && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.leaderId == request.auth.uid
            && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.sponsorId == request.resource.data.teacherId
            && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.sponsorStatus == 'pending')
        );
      allow read: if isAdmin() || (signedIn() && (
        resource.data.teacherId == request.auth.uid || resource.data.get('previousSponsorId', '') == request.auth.uid
        || resource.data.requestedById == request.auth.uid || isMember(resource.data.clubId) || isManager(resource.data.clubId)
      ));
      allow update: if isAdmin()
        || (signedIn()
          && userRole() == 'student'
          && resource.data.status == 'declined'
          && request.resource.data.stage == 'currentSponsorApproval'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedById == request.auth.uid
          && (isMember(resource.data.clubId) || isLeader(resource.data.clubId))
          && onlyChanged(['clubId','clubName','teacherId','teacherName','requestedById','requestedByName','previousSponsorId','previousSponsorName','stage','status','createdAt']))
        || (isTeacher()
          && resource.data.previousSponsorId == request.auth.uid
          && resource.data.stage == 'currentSponsorApproval'
          && resource.data.status == 'pending'
          && onlyChanged(['stage'])
          && request.resource.data.stage == 'newSponsorApproval')
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && resource.data.stage == 'newSponsorApproval'
          && resource.data.status == 'pending'
          && onlyChanged(['status'])
          && request.resource.data.status in ['accepted','declined'])
        || (isTeacher()
          && !('stage' in resource.data.keys())
          && resource.data.teacherId == request.auth.uid
          && resource.data.status == 'pending'
          && onlyChanged(['status'])
          && request.resource.data.status in ['accepted','declined']);
      allow delete: if isAdmin() || (isLeader(resource.data.clubId) && deletionApproved(resource.data.clubId));
    }

    match /officerInvitations/{invitationId} {
      allow create: if signedIn()
        && request.resource.data.clubId is string
        && request.resource.data.invitedUserId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.invitedUserId)).data.role == 'student'
        && request.resource.data.invitedById == request.auth.uid
        && isManager(request.resource.data.clubId)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['clubId','clubName','invitedUserId','invitedUserName','invitedById','invitedByName','title','status','createdAt']);
      allow read: if isAdmin() || (signedIn() && (
        resource.data.invitedUserId == request.auth.uid || isManager(resource.data.clubId)
      ));
      allow update: if isAdmin()
        || (signedIn() && isManager(resource.data.clubId)
          && request.resource.data.status == 'pending'
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.invitedUserId == resource.data.invitedUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubName','invitedUserName','invitedById','invitedByName','title','status','createdAt']))
        || (signedIn() && resource.data.invitedUserId == request.auth.uid
          && userRole() == 'student'
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','declined']);
      allow delete: if isAdmin() || isManager(resource.data.clubId);
    }

    match /moderationReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.clubId is string
        && request.resource.data.clubName is string
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.details is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || isManager(resource.data.clubId) || isMember(resource.data.clubId);
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.clubId is string
        && isManager(request.resource.data.clubId)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.createdAt is number;
      allow update: if isAdmin() || (isManager(resource.data.clubId) && onlyChanged(['title','body','pinned','updatedAt']));
      allow delete: if isAdmin() || isManager(resource.data.clubId);
    }

    match /announcementReactions/{reactionId} {
      allow read: if isAdmin() || isManager(resource.data.clubId) || isMember(resource.data.clubId);
      allow create: if signedIn()
        && reactionId == request.resource.data.announcementId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.announcementId is string
        && request.resource.data.clubId is string
        && get(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)).data.clubId == request.resource.data.clubId
        && (isAdmin() || isManager(request.resource.data.clubId) || isMember(request.resource.data.clubId))
        && request.resource.data.emoji in ['👍','❤️','🎉','😂','👏']
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(['announcementId','clubId','uid','emoji','createdAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && (isAdmin() || isManager(resource.data.clubId) || isMember(resource.data.clubId))
        && onlyChanged(['emoji','createdAt'])
        && request.resource.data.emoji in ['👍','❤️','🎉','😂','👏'];
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || (isLeader(resource.data.clubId) && deletionApproved(resource.data.clubId));
    }

    match /events/{eventId} {
      allow read: if isAdmin() || isManager(resource.data.clubId) || isMember(resource.data.clubId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.clubId is string
        && isManager(request.resource.data.clubId)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.startAt is number
        && request.resource.data.createdAt is number;
      allow update: if isAdmin() || (isManager(resource.data.clubId)
        && onlyChanged(['title','description','location','startAt','endAt','type','attendance','updatedAt','deletedAt']));
      allow delete: if isAdmin() || isManager(resource.data.clubId);
    }

    match /eventRsvps/{rsvpId} {
      allow read: if isAdmin() || isManager(resource.data.clubId) || isMember(resource.data.clubId);
      allow create, update: if signedIn()
        && userRole() == 'student'
        && isMember(request.resource.data.clubId)
        && rsvpId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.clubId is string
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.clubId == request.resource.data.clubId
        && request.resource.data.status in ['going','maybe','notGoing']
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().hasOnly(['eventId','clubId','uid','status','updatedAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || (isLeader(resource.data.clubId) && deletionApproved(resource.data.clubId));
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function clubDoc(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    function isClubLeader(clubId) {
      return isSignedIn() && clubDoc(clubId).leaderId == request.auth.uid;
    }

    function isClubOfficer(clubId) {
      return isSignedIn() && clubDoc(clubId).get('officerIds', []).hasAny([request.auth.uid]);
    }

    function isClubSponsor(clubId) {
      return isSignedIn()
        && clubDoc(clubId).sponsorId == request.auth.uid
        && clubDoc(clubId).sponsorStatus == 'accepted';
    }

    function isClubManager(clubId) {
      return isAdmin() || isClubLeader(clubId) || isClubSponsor(clubId) || isClubOfficer(clubId);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── User profiles ──────────────────────────────────────────────────────
    // During testing, signup can create student, teacher, or admin profiles.
    // Restrict this allowlist before opening ClubStack for real school use.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['student', 'teacher', 'admin']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.email is string;

      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && onlyChanged(['displayName', 'grade'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2);

      allow delete: if isAdmin();
    }

    // ── Minimal directory for teacher and officer selection ────────────────
    // Directory entries intentionally omit email and grade.
    match /userDirectory/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'createdAt', 'nameLower'])
        && request.resource.data.displayName is string
        && request.resource.data.role in ['student', 'teacher', 'admin']
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(userId)).data.role
        && request.resource.data.nameLower is string);
      allow delete: if isAdmin();
    }

    // ── Moderation reports ─────────────────────────────────────────────────
    // Public account registration currently allows teacher/admin roles for testing.
    // Reports are visible to platform admins and to their original reporter.
    match /moderationReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.clubId is string
        && request.resource.data.clubName is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.details is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number;

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // ── Clubs ──────────────────────────────────────────────────────────────
    // New pages are always created as "pending" with the creator as leader.
    // Admins approve or reject them; leaders may edit their own content but
    // cannot change the leader, status, or creation date.
    match /clubs/{clubId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.category is string
        && request.resource.data.emoji is string
        && request.resource.data.contactEmail is string
        && request.resource.data.memberCount == 0
        && request.resource.data.createdAt is number
        && request.resource.data.leaderTitle is string
        && request.resource.data.officers is list
        && request.resource.data.officerIds is list
        && request.resource.data.sponsorId is string
        && request.resource.data.sponsorName is string
        && request.resource.data.sponsorStatus in ['pending', 'none'];

      allow update: if isAdmin()
        || (isClubLeader(clubId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                 ['leaderId', 'status', 'createdAt', 'memberCount']))
        || ((isClubSponsor(clubId) || isClubOfficer(clubId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['name', 'description', 'category', 'meetingDay', 'meetingTime', 'location', 'emoji', 'color', 'contactEmail', 'leaderTitle', 'officers', 'officerIds']))
        || (isTeacher()
            && resource.data.sponsorId == request.auth.uid
            && resource.data.sponsorStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sponsorId', 'sponsorName', 'sponsorStatus'])
            && request.resource.data.sponsorStatus in ['accepted', 'declined'])
        || (isSignedIn()
            && !(resource.data.officerIds is list && resource.data.officerIds.hasAny([request.auth.uid]))
            && request.resource.data.officerIds is list
            && request.resource.data.officerIds.hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['officers', 'officerIds'])
            && getAfter(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/officerInvitations/$(clubId + '_' + request.auth.uid)).data.invitedUserId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student')
        || (isSignedIn()
            && onlyChanged(['memberCount'])
            && request.resource.data.memberCount is number
            && request.resource.data.memberCount >= 0
            && (request.resource.data.memberCount == resource.data.memberCount + 1
                || request.resource.data.memberCount == resource.data.memberCount - 1));

      allow delete: if isAdmin();
    }

    // ── Teacher sponsor requests ──────────────────────────────────────────
    match /clubSponsorRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.teacherId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role == 'teacher'
        && request.resource.data.clubId is string
        && clubDoc(request.resource.data.clubId).leaderId == request.auth.uid
        && clubDoc(request.resource.data.clubId).sponsorId == request.resource.data.teacherId
        && clubDoc(request.resource.data.clubId).sponsorStatus == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number;

      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.teacherId == request.auth.uid || resource.data.requestedById == request.auth.uid));

      allow update: if isAdmin()
        || (isTeacher()
            && resource.data.teacherId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'declined']);

      allow delete: if isAdmin();
    }

    // ── Student officer invitations ───────────────────────────────────────
    // A deterministic ID (clubId_userId) permits safe acceptance in one batch.
    match /officerInvitations/{invitationId} {
      allow create: if isSignedIn()
        && request.resource.data.clubId is string
        && request.resource.data.invitedUserId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.invitedUserId)).data.role == 'student'
        && request.resource.data.invitedById == request.auth.uid
        && isClubManager(request.resource.data.clubId)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['clubId', 'clubName', 'invitedUserId', 'invitedUserName', 'invitedById', 'invitedByName', 'title', 'status', 'createdAt']);

      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.invitedUserId == request.auth.uid || isClubManager(resource.data.clubId)));

      allow update: if isAdmin()
        || (isSignedIn() && isClubManager(resource.data.clubId)
            && request.resource.data.status == 'pending'
            && request.resource.data.clubId == resource.data.clubId
            && request.resource.data.invitedUserId == resource.data.invitedUserId
            && request.resource.data.invitedById == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['clubName', 'invitedUserName', 'invitedById', 'invitedByName', 'title', 'status', 'createdAt']))
        || (isSignedIn()
            && resource.data.invitedUserId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'declined']);

      allow delete: if isAdmin() || isClubManager(resource.data.clubId);
    }

    // ── Memberships ────────────────────────────────────────────────────────
    // Students join approved clubs. A leader may join their own pending club
    // (the 1 member counted at creation).
    match /memberships/{membershipId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin() || isClubManager(resource.data.clubId));

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clubId is string
        && request.resource.data.joinedAt is number
        && (clubDoc(request.resource.data.clubId).status == 'approved'
            || clubDoc(request.resource.data.clubId).leaderId == request.auth.uid);

      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update: if false;
    }

    // ── Announcements ──────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.clubId is string
        && isClubManager(request.resource.data.clubId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.createdAt is number;

      allow update: if isAdmin()
        || (isClubManager(resource.data.clubId) && onlyChanged(['title', 'body']));

      allow delete: if isClubManager(resource.data.clubId);
    }

    // ── Meetings & events ──────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.clubId is string
        && isClubManager(request.resource.data.clubId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startAt is number
        && request.resource.data.createdAt is number;

      allow update: if isAdmin()
        || (isClubManager(resource.data.clubId)
            && onlyChanged(['title', 'description', 'location', 'startAt', 'endAt']));

      allow delete: if isClubManager(resource.data.clubId);
    }
  }
}

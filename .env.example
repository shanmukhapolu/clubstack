# Copy this file to `.env.local` and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Leave unset for the normal behaviour:
#   - All required values present  → use Firebase
#   - Any required value missing   → run in local demo mode (data in localStorage)
# Set to "true" to force demo mode even when Firebase is configured.
# VITE_DEMO_MODE=false

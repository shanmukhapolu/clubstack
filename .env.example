# Optional overrides.
#
# ClubStack already ships with the clubstackapp2 Firebase client configuration
# in `src/lib/firebaseConfig.ts`, so this file is only needed to point a build
# at a different Firebase project.
#
# Copy it to `.env.local` (git-ignored) and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Force the offline demo backend (sample data in localStorage) even though
# Firebase is configured. Leave unset to use Firebase.
# VITE_DEMO_MODE=true
